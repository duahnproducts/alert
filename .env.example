# Chép thành .env.local (không commit) và điền giá trị. Trên Vercel: Settings → Environment Variables.
# Mọi biến VITE_* đều lộ ra trình duyệt: KHÔNG BAO GIỜ đặt secret key (sb_secret_…) vào đây.

# Supabase → Settings → API Keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Domain thật, không có dấu / ở cuối (dùng cho ảnh xem trước khi dán link vào Facebook)
VITE_SITE_URL=https://quan-quen.vercel.app
